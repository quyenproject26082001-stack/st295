<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:background="@drawable/bg_16_solid_white_stroke_brownn"
            >

            <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
                android:id="@+id/tvTitle"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginStart="@dimen/dp_16"
                android:fontFamily="@font/howli_layers_base"
                android:gravity="center"
                android:text="@string/choose_color"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_24"
                app:outerStrokeWidth="@dimen/dp_6"
                app:outerStrokeColor="@color/app"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RelativeLayout
                android:id="@+id/top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_alignParentEnd="true"
                    app:tint="#FFFFFF"
                    android:visibility="invisible"
                    android:src="@drawable/ic_close_color_pick"
                    />
            </RelativeLayout>

            <ir.kotlin.kavehcolorpicker.KavehColorPicker
                android:id="@+id/colorPickerView"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_160"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_10"
                app:sliderStrokeSize="@dimen/dp_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/dp_30"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/colorPickerView"
                app:layout_constraintBottom_toBottomOf="parent">

                <ir.kotlin.kavehcolorpicker.KavehHueSlider
                    android:id="@+id/hueSlider"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderStrokeSize="@dimen/dp_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_height="@dimen/dp_30" />


                <!--                btnDone-->
                <RelativeLayout
                    android:id="@+id/btnDone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="end"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginTop="@dimen/dp_15"
                    app:layout_constraintDimensionRatio="140:40"
                    android:background="@drawable/bg_done_pickercolor"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnClose"
                    app:layout_constraintTop_toBottomOf="@id/hueSlider"
                    >
                    <TextView
                        android:id="@+id/btnDoneText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:layout_centerVertical="true"
                        android:text="@string/done"
                        android:includeFontPadding="false"
                        style="@style/single_marquee"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_20"/>
                </RelativeLayout>
                <!--                btnDone-->
                <RelativeLayout
                    android:id="@+id/btnClose"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="@dimen/dp_8"
                    app:layout_constraintDimensionRatio="140:40"

                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/dp_15"
                    android:background="@drawable/bg_done_pickercolor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnDone"
                    app:layout_constraintTop_toBottomOf="@id/hueSlider"
                    >
                    <TextView
                        android:id="@+id/btnCancelText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/cancel"
                        style="@style/single_marquee"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_20" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/btnStringColor"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_36"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/dp_6"
                    android:visibility="gone"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnDone"
                    app:layout_constraintBottom_toBottomOf="@id/btnDone"
                    app:layout_constraintEnd_toStartOf="@id/btnDone"
                    android:background="@drawable/bg_string_color">

                    <TextView
                        android:id="@+id/tvColorString"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:text="#FFFFFF"
                        android:layout_marginStart="@dimen/dp_12"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_20" />
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>