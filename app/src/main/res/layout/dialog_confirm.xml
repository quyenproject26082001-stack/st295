<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!--    flOutSide-->
    <FrameLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            app:cardBackgroundColor="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="@dimen/dp_328"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_delete_exit">

                <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@color/transparent"
                    android:fontFamily="@font/howli_layers_base"
                    android:gravity="center"
                    android:paddingVertical="@dimen/dp_5"
                    android:text="@string/delete"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_24"
                    app:outerStrokeColor="@color/app"
                    app:outerStrokeWidth="@dimen/dp_5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--            tvDescription-->
                <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/howli_layers_base"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_24"
                    android:text="@string/do_you_want_to_exit"
                    android:textColor="@color/app"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:textSize="@dimen/sp_20"
                    app:layout_constraintVertical_bias="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/llButtons"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <LinearLayout
                    android:id="@+id/llButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_30"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">


                    <!--                    btnNo-->
                    <TextView
                        android:id="@+id/btnNo"
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="@dimen/dp_42"
                        android:background="@drawable/bg_btn_dialog"
                        android:layout_weight="1"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:text="@string/no"
                        android:visibility="visible"
                        android:includeFontPadding="false"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_18"
                        />

                    <!--                    btnYes-->
                    <TextView
                        android:id="@+id/btnYes"
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="@dimen/dp_42"
                        android:background="@drawable/bg_btn_dialog"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_weight="1"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:text="@string/yes"
                        android:includeFontPadding="false"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_18" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/spin"
                android:layout_width="@dimen/dp_42"
                android:layout_height="@dimen/dp_42"
                android:layout_gravity="center"
                android:src="@drawable/ic_loading"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

    </FrameLayout>
</layout>
