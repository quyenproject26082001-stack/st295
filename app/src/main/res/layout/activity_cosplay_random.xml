<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="false"
    android:clipToOutline="false"
    android:clipToPadding="false"
    tools:context=".ui.cosplay.CosplayRandomActivity">

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    cvImage-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_marginBottom="@dimen/dp_16"
        app:strokeColor="@color/app"
        app:cardCornerRadius="@dimen/dp_40"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintVertical_bias="0.01">

        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_32"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvImage">

        <FrameLayout
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:background="@drawable/bg_random_cosplayrandomnd"
            android:paddingEnd="0dp"
            app:layout_constraintDimensionRatio="328:56">

            <TextView
                android:id="@+id/tvRandom"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="0dp"
                android:fontFamily="@font/howli_layers_base"
                android:gravity="center"
                android:text="@string/random"
                android:layout_marginBottom="@dimen/dp_3"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_18"
                android:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnCosPlay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:layout_weight="1"
            android:background="@drawable/bg_cosplay_cosplayrandom"
            android:paddingEnd="0dp"
            app:layout_constraintDimensionRatio="328:56">

            <TextView
                android:id="@+id/tvCosplay"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="0dp"
                android:fontFamily="@font/howli_layers_base"
                android:gravity="center"
                android:layout_marginBottom="@dimen/dp_3"
                android:text="@string/playcos"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_18"
                android:visibility="visible" />
        </FrameLayout>

    </LinearLayout>

    <!-- Overlay chặn touch khi guide đang mở -->
    <View
        android:id="@+id/vOverlayGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- containerGuide ở cuối để có z-order cao nhất -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dp_22"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <TextView
            android:id="@+id/titleGuide"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_78"
            android:layout_marginTop="@dimen/dp_4"
            android:elevation="@dimen/dp_3"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_10"
            android:text="@string/instruction"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/bg_frame1" />


        <TextView
            android:id="@+id/bg_frame1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@drawable/bg_frameguide_cosplayrandom"
            android:clipToOutline="false"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="@id/bg_frame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/bg_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_minus_15"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:letterSpacing=".02"
            android:paddingBottom="@dimen/dp_80"
            android:lineSpacingMultiplier="1"
            android:paddingHorizontal="@dimen/dp_10"
            android:paddingTop="0dp"
            android:text="@string/guide_cosplay"
            android:textColor="#333333"
            android:textSize="@dimen/sp_18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleGuide" />

        <ImageView
            android:id="@+id/ivBtn"
            android:layout_width="@dimen/dp_136"
            android:layout_height="@dimen/dp_40"
            android:layout_gravity="bottom|center_horizontal"
            android:translationY="@dimen/dp_minus_76"
            android:src="@drawable/bg_close_cosplayrandom"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/bg_frame1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/btnCloseGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:elevation="@dimen/dp_5"
            android:focusable="true"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_18"
            app:layout_constraintEnd_toEndOf="@id/ivBtn"
            app:layout_constraintStart_toStartOf="@id/ivBtn"
            app:layout_constraintBottom_toBottomOf="@id/ivBtn"
            android:translationY="@dimen/dp_minus_76"
            app:layout_constraintTop_toTopOf="@id/ivBtn" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
