<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.trending.TrendingActivity"
    android:background="@drawable/bg_app">

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


     <!--    cvImage-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="0dp"
        app:strokeColor="@color/app"
        app:strokeWidth="@dimen/dp_6"
        app:cardCornerRadius="@dimen/dp_40"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintVertical_bias=".1"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/btnEditTrending"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:src="@drawable/ic_edit_trending"
            android:layout_gravity="end|top"
            android:layout_marginEnd="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_19"
            android:visibility="gone" />

    </com.google.android.material.card.MaterialCardView>





    <FrameLayout
        android:id="@+id/btnGenerate"
        android:layout_width="@dimen/dp_156"
        android:layout_height="@dimen/dp_44"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintDimensionRatio="156:44"
        android:layout_marginTop="@dimen/dp_32"
        app:layout_constraintTop_toBottomOf="@id/cvImage"
        android:background="@drawable/bg_random_trending">

        <TextView
            android:id="@+id/tvGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generate"
            android:fontFamily="@font/howli_layers_base"
            style="@style/single_marquee"
            android:visibility="visible"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="@dimen/sp_16"/>
        
    </FrameLayout>




</androidx.constraintlayout.widget.ConstraintLayout>