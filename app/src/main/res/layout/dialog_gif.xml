<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clipChildren="false"
    android:clipToOutline="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="16dp"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerDialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_16_solid_white_stroke_brownn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <TextView
                android:id="@+id/tvArrowLeft"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/arrow_spin"
                android:gravity="center"
                android:textSize="42sp"
                android:elevation="3dp"
                android:layout_marginEnd="-8dp"
                app:layout_constraintBottom_toBottomOf="@id/slotRow"
                app:layout_constraintEnd_toStartOf="@id/slotRow"
                app:layout_constraintTop_toTopOf="@id/slotRow" />

            <TextView
                android:id="@+id/tvArrowRight"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/arrow_spin"
                android:gravity="center"
                android:elevation="3dp"
                android:scaleX="-1"
                android:layout_marginStart="-8dp"
                app:layout_constraintBottom_toBottomOf="@id/slotRow"
                app:layout_constraintStart_toEndOf="@id/slotRow"
                app:layout_constraintTop_toTopOf="@id/slotRow" />

            <LinearLayout
                android:id="@+id/slotRow"
                android:layout_width="0dp"
                android:layout_height="162dp"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_gif_slot_row"
                android:clipChildren="true"
                android:clipToOutline="true"
                android:clipToPadding="true"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnSpin"
                android:layout_width="156dp"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="29dp"
                android:background="@drawable/bg_btn_dialog"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/slotRow"
                app:layout_constraintVertical_bias="0">



                <ImageView
                    android:id="@+id/imgAds"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/img_ads"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/btnFree"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnFree"
                    app:layout_constraintTop_toTopOf="@id/btnFree" />

                <TextView
                    android:id="@+id/btnFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/howli_layers_base"
                    android:gravity="center"
                    android:text="@string/spin"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgAds"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.create.lalala.core.custom.text.DoubleStrokeTextView
                android:id="@+id/tvCountDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/howli_layers_base"
                android:text="00:00:00"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/btnSpin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/btnSpin"
                app:layout_constraintStart_toStartOf="@id/btnSpin"
                app:outerStrokeColor="@color/app"
                app:outerStrokeWidth="1dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:elevation="3dp"
            android:src="@drawable/ic_close_gif"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerDialog" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:paddingHorizontal="40dp"
            android:background="@drawable/title_win"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/howli_layers_base"
                android:gravity="center"
                android:text="@string/lucky_gift"
                android:textColor="#333333"
                android:textSize="18sp"
                android:letterSpacing="-.0"
                android:autoSizeMinTextSize="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/gift_lucky"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvTitle"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                android:src="@drawable/gift_lucky"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvTitle"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/rewardRow"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerDialog">

            <ImageView
                android:id="@+id/imgReward1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_gif_collected"
                android:padding="5dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/imgReward2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_gif_collected"
                android:padding="5dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/imgReward3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_gif_collected"
                android:padding="5dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/imgReward4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_gif_collected"
                android:padding="5dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/imgReward5"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_gif_collected"
                android:padding="5dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCollect"
            android:layout_width="132dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_dialog"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:text="@string/collect"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rewardRow" />


        <TextView
            android:id="@+id/btnShowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:text="@string/you_ve_unlocked_more_accessories_collect_them_and_create_your_own_character"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
