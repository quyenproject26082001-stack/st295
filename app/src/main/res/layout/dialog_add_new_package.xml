<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:strokeColor="@color/app"
        app:cardCornerRadius="50dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="16dp"
        app:strokeWidth="3dp">

        <com.create.lalala.core.custom.text.DoubleStrokeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="5dp"
            android:layout_marginTop="18dp"
            android:text="@string/new_package_"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:outerStrokeColor="@color/app"
            app:outerStrokeWidth="6dp" />


      <EditText
          android:id="@+id/edPackage"
          android:layout_width="match_parent"
          android:layout_height="40dp"
          android:background="@drawable/bg_edit_text"
          android:layout_marginTop="74dp"
          android:layout_marginHorizontal="16dp"
          android:paddingStart="12dp"
          android:maxLength="15"
          android:hint="Enter your name package... "
          android:fontFamily="@font/howli_layers_base"
          android:textColor="#80868686"
          android:textSize="14sp"

          />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:strokeColor="@color/app"
            app:strokeWidth="2dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="144dp"
            android:id="@+id/btnAddPackageInput"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/app"
                android:textSize="20sp"
                android:layout_marginHorizontal="20dp"
                android:text="@string/add_to_package_2"
                android:fontFamily="@font/howli_layers_base"
                android:gravity="center"
                android:layout_gravity="center"
                android:includeFontPadding="false"/>

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="184dp"
            />

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
