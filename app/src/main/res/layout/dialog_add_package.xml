<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:strokeColor="@color/app"
        app:cardCornerRadius="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        app:strokeWidth="3dp">

        <com.create.lalala.core.custom.text.DoubleStrokeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="5dp"
            android:layout_marginTop="18dp"
            android:text="@string/add_to_package_"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:outerStrokeColor="@color/app"
            app:outerStrokeWidth="6dp" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="10"
            android:layout_marginHorizontal="10dp"
            android:orientation="horizontal"
            android:layout_marginTop="74dp"
            tools:listitem="@layout/item_add_package"
            />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:strokeColor="@color/app"
            app:strokeWidth="2dp"
            app:cardCornerRadius="16dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="194dp"
            android:id="@+id/btnAddPackage"
            >
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/app"
                android:textSize="20sp"
                android:layout_marginHorizontal="20dp"
                android:text="@string/add_to_package_2"
                android:fontFamily="@font/howli_layers_base"
                android:gravity="center"
                android:layout_gravity="center"
                android:includeFontPadding="false"/>
            
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="234dp"
            />

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>
