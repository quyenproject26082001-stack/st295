<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="156dp"
    android:layout_height="40dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_creation_tab_unselected">

    <com.create.lalala.core.custom.text.DoubleStrokeTextView
        android:id="@+id/tvName"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/howli_layers_base"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#FF8600"
        android:textSize="18sp" />

    <View
        android:id="@+id/viewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="false" />

</FrameLayout>
