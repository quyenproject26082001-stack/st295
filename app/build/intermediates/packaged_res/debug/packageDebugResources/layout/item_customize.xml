<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    app:layout_constraintDimensionRatio="1:1"
    android:layout_margin="@dimen/dp_1_5">



    <!--        vFocus-->
    <View
        android:id="@+id/vFocus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <FrameLayout
        android:id="@+id/cardLayerItem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_2"
        tools:background="@drawable/layer_slt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--                    imvImage-->
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:padding="@dimen/dp_10"
            android:src="@color/red_BA"
            android:clipToOutline="true"
            />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.7"
            app:shimmer_direction="left_to_right"
            app:shimmer_duration="1800"
            app:shimmer_highlight_alpha="0.6"
            app:shimmer_shape="linear">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_8_gray" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!--            btnNone-->
        <ImageView
            android:id="@+id/btnNone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:translationY="@dimen/dp_minus_2"
            android:padding="@dimen/dp_16"

            android:layout_margin="@dimen/dp_1"
            android:scaleType="fitXY"
            app:tint="#212121"
            android:src="@drawable/ic_none"
            android:visibility="gone"
            />

        <!--            btnRandom-->
        <ImageView
            android:id="@+id/btnRandom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:layout_margin="@dimen/dp_1"
            android:focusable="true"
            android:padding="@dimen/dp_16"
            app:tint="#212121"

            android:translationY="@dimen/dp_minus_2"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_random_layer"
            android:visibility="gone" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
