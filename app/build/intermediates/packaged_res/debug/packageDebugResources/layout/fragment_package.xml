<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#FF8600"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/dp_16"
    android:clipToPadding="true"
    tools:context=".ui.my_creation.fragment.MyDesignFragment">

    <!--    rcvMyDesign-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvMyDesign"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp_4"
        android:clipChildren="false"
        android:layout_gravity="center"
        android:layout_marginTop="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:spanCount="1"
        tools:listitem="@layout/item_package_creation" />

    <!-- No Item-->
    <LinearLayout
        android:id="@+id/layoutNoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dp_50"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_152"
            android:visibility="invisible"
            android:adjustViewBounds="true"
            android:src="@drawable/img_no_item" />

        <TextView
            android:id="@+id/tvNoitem"

            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_37"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_33"
            android:text="@string/no_item_here"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_18"
            android:translationY="0dp" />
    </LinearLayout>

</FrameLayout>