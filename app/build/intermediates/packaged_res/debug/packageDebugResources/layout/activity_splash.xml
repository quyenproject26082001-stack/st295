<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.splash.SplashActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app" />



    <ImageView
        android:id="@+id/imgAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/splash1"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:src="@drawable/app_name"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_32"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_10"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:src="@drawable/ic_character_splash"
        app:layout_constraintDimensionRatio="422:520"
        app:layout_constraintTop_toBottomOf="@id/imgAppName"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />
    <!-- tvDes -->
    <TextView
        android:id="@+id/tvDes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_33"
        android:layout_marginBottom="@dimen/dp_40"
        android:fontFamily="@font/nunito_medium"
        android:gravity="center"
        android:text="@string/this_action_can_contain_ads"
        android:textColor="#99FFFFFF"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- layoutLoading -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_70"
        android:layout_marginBottom="@dimen/dp_6"
        app:layout_constraintBottom_toTopOf="@+id/tvDes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivLoading"
            android:layout_width="@dimen/dp_37"
            android:layout_height="@dimen/dp_37"
            android:tint="#FF8600"
            android:layout_gravity="center"
            android:src="@drawable/ic_loading_spinner" />

    </FrameLayout>

<!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
<!--    <FrameLayout-->
<!--        android:id="@+id/flNativeCollab"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        app:layout_constraintBottom_toBottomOf="parent">-->

<!--        <include layout="@layout/ads_shimmer_collap_native" />-->
<!--    </FrameLayout>-->

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:id="@+id/gld"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.4" />
</androidx.constraintlayout.widget.ConstraintLayout>