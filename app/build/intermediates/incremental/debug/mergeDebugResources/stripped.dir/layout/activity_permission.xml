<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.permission.PermissionActivity">


    <!-- imgPermission -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app"
        android:scaleType="centerCrop"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <ImageView
        android:id="@+id/imgPermission"
        android:layout_width="@dimen/dp_180"
        android:layout_height="0dp"
        android:maxHeight="@dimen/dp_329"
        android:minHeight="@dimen/dp_188"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintDimensionRatio="232:178"
        android:layout_gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:adjustViewBounds="true"
        android:src="@drawable/img_permission" />

    <!-- txtPermission -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/txtPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintTop_toBottomOf="@id/imgPermission"
        android:fontFamily="@font/londrina_solid_regular">

        <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
            android:id="@+id/txtPer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/dp_20"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"
            tools:text="Allow Permissionsằbfbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbaaa" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- btnStorage -->
    <RelativeLayout
        android:id="@+id/btnStorage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_59"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_16"

        app:layout_constraintTop_toBottomOf="@id/btnNotification"
        android:background="@drawable/bg_frame_per">

        <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="start"
            android:includeFontPadding="false"
            android:text="@string/storage"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_16" />

        <ImageView
            android:id="@+id/swPermission"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_32"
            android:layout_alignParentEnd="true"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:src="@drawable/ic_sw_off" />
    </RelativeLayout>

    <!-- btnNotification -->
    <RelativeLayout
        android:id="@+id/btnNotification"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_59"
        app:layout_constraintTop_toBottomOf="@id/txtPermission"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:background="@drawable/bg_frame_per">

        <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:fontFamily="@font/howli_layers_base"
            android:gravity="start"
            android:includeFontPadding="false"
            android:text="@string/notification"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_16" />

        <ImageView
            android:id="@+id/swNotification"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_32"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"

            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/dp_16"
            android:src="@drawable/ic_sw_on" />
    </RelativeLayout>



    <!-- tvPermission badge — đặt sau cardContainer để render đè lên top card -->
    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
        android:id="@+id/tvPermission"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_56"
        android:textSize="@dimen/sp_24"
        android:layout_marginStart="@dimen/dp_15_5"

        android:elevation="@dimen/dp_4"
        android:fontFamily="@font/howli_layers_base"
        android:gravity="center"
        android:text="@string/permission"
        android:textColor="@color/white"
        android:visibility="gone"
        android:shadowRadius="4"
        android:shadowDy="4"
        app:outerStrokeWidth="@dimen/dp_5"
        app:outerStrokeColor="@color/app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- tvContinue -->
    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
        android:id="@+id/tvContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_16"
        android:fontFamily="@font/howli_layers_base"
        android:gravity="center"
        app:outerStrokeWidth="@dimen/dp_5"
        app:outerStrokeColor="@color/app"
        android:text="@string/continue_per"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        app:layout_constraintBottom_toTopOf="@id/native_ads"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <FrameLayout
        android:id="@+id/native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <include layout="@layout/ads_native_big_btn_bottom_shimmer" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
