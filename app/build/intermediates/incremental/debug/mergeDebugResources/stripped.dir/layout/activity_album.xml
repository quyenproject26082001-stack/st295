<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.my_creation.MyCreationActivity">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/bg_app"/>

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    &lt;!&ndash;    native_ads&ndash;&gt;-->
        <FrameLayout
            android:id="@+id/native_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

            <include layout="@layout/ads_native_collap_banner_shimmer" />
        </FrameLayout>




    <!--    frmList-->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/frmList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_goneMarginTop="0dp"
        tools:background="@color/white"
        android:layout_marginTop="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvType" />
    <!--    cvType-->
    <FrameLayout
        android:id="@+id/cvType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginHorizontal="0dp"
        app:layout_constraintTop_toBottomOf="@id/native_ads">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnMyEmoji"
                    android:layout_width="@dimen/dp_156"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:background="@drawable/bg_creation_tab_unselected">

                    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tvMyEmoji"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/my_emoji"
                        android:textColor="#FF8600"
                        android:textSize="@dimen/sp_18" />

                    <View
                        android:id="@+id/overlayMyEmoji"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33000000"
                        android:clickable="false" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnMyPixel"
                    android:layout_width="@dimen/dp_156"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:background="@drawable/bg_creation_tab_unselected">

                    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tvMyPride"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/my_avatar"
                        android:textColor="#FF8600"
                        android:textSize="@dimen/sp_18" />

                    <View
                        android:id="@+id/overlayMyPride"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33000000"
                        android:clickable="false" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnMyDesign"
                    android:layout_width="@dimen/dp_156"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:background="@drawable/bg_creation_tab_unselected">

                    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tvMyDesign"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/my_design"
                        android:textColor="#FF8600"
                        android:textSize="@dimen/sp_18" />

                    <View
                        android:id="@+id/overlayMyDesign"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33000000"
                        android:clickable="false" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnPackage"
                    android:layout_width="@dimen/dp_156"
                    android:layout_height="@dimen/dp_40"
                    android:background="@drawable/bg_creation_tab_unselected">

                    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tvPackage"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/howli_layers_base"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/package_"
                        android:textColor="#FF8600"
                        android:textSize="@dimen/sp_18" />

                    <View
                        android:id="@+id/overlayPackage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33000000"
                        android:clickable="false" />

                </FrameLayout>

            </LinearLayout>

        </HorizontalScrollView>

    </FrameLayout>

    <!--    flBottomView (share/download - shown in select mode) -->
    <FrameLayout
        android:id="@+id/flBottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="0dp"
        android:elevation="@dimen/dp_2"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/lnlBottom">

        <include
            android:id="@+id/bottomView"
            layout="@layout/layout_bottom_creation" />

    </FrameLayout>

    <!--    lnlBottom (whatsapp/telegram) -->
    <FrameLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="0dp"
        android:background="@color/transparent"
        android:elevation="@dimen/dp_1"
        android:visibility="visible"
        android:layout_marginBottom="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginBottom="@dimen/dp_24">

        <include layout="@layout/layout_bottom" />

    </FrameLayout>


    <!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
        <FrameLayout
            android:id="@+id/flNativeCollab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/dp_100"
            app:layout_constraintBottom_toBottomOf="parent">

        </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
