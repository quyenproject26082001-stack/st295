<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.intro.IntroActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
       android:background="@drawable/bg_app"
        />

    <!--    vpgTutorial-->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpgTutorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_36"
        android:overScrollMode="never"
        tools:src="@layout/item_intro"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintBottom_toTopOf="@+id/dotsIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--    dotsIndicator-->
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:dotsColor="#FFFFFF"
        app:dotsCornerRadius="@dimen/dp_8"
        app:dotsSize="@dimen/dp_9"
        app:dotsSpacing="@dimen/dp_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:dotsWidthFactor="2.5"
        app:layout_constraintBottom_toBottomOf="@id/btnNext"
        app:layout_constraintTop_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:progressMode="false"
        app:selectedDotColor="#FF8600" />

    <!--    btnNext-->
    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_16"
        android:fontFamily="@font/howli_layers_base"
        android:padding="@dimen/dp_3"
        app:outerStrokeWidth="@dimen/dp_5"
        app:outerStrokeColor="@color/app"
        android:text="@string/next_intro"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="@dimen/sp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/native_ads"
        />


<!--    &lt;!&ndash;    native_ads&ndash;&gt;-->
    <FrameLayout
        android:id="@+id/native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/ads_native_medium_btn_bottom_shimmer" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>