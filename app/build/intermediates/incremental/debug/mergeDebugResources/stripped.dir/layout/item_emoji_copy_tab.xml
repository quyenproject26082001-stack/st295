<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_156"
    android:layout_height="@dimen/dp_40"
    android:layout_marginEnd="@dimen/dp_6"
    android:background="@drawable/bg_creation_tab_unselected">

    <com.emojimaker.horor.emoji.core.custom.text.DoubleStrokeTextView
        android:id="@+id/tvName"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/howli_layers_base"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#FF8600"
        android:textSize="@dimen/sp_18" />

    <View
        android:id="@+id/viewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="false" />

</FrameLayout>
