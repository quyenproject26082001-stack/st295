<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_5"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_90"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardBackgroundColor="@color/app"
        android:id="@+id/btnAdd"
        >

        <ImageView
            android:id="@+id/ic_add_image"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_minus_10"
            android:src="@drawable/ic_add_package" />

        <TextView
            android:id="@+id/tvAddPackage"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/dp_16"
            android:textSize="@dimen/sp_14"
            android:fontFamily="@font/howli_layers_base"
            android:text="@string/new_package"
            android:gravity="center"
            android:textColor="@color/white" />


    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_90"
        app:strokeColor="#212121"
        app:strokeWidth="@dimen/dp_0_5"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardBackgroundColor="@color/white"
        android:id="@+id/btnAvailable"
        >

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_68"
            android:id="@+id/ivItem"
            android:scaleType="centerCrop"
            tools:src="@drawable/item_empty"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_22"
            android:background="@color/app"
            android:layout_gravity="bottom"
            android:id="@+id/tvPackageName"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            tools:text="Package_1"
            style="@style/single_marquee"
            android:gravity="center"
            android:fontFamily="@font/howli_layers_base"
            />



    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>