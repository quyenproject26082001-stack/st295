<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="@dimen/dp_58">

    <ImageView
        android:id="@+id/btnShowLayer"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginStart="@dimen/dp_16"
        android:src="@drawable/ic_show_emoji"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_42"
        android:layout_height="@dimen/dp_42"
        app:cardCornerRadius="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnShowLayer"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#212121"
        app:cardBackgroundColor="@color/white"
        android:layout_marginStart="@dimen/dp_13"
        app:strokeWidth="@dimen/dp_1">

        <ImageView
            android:id="@+id/imvLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Layer"
        android:textSize="@dimen/sp_16"
        android:fontFamily="@font/howli_layers_base"
        android:textColor="#212121"
        android:layout_marginStart="@dimen/dp_70"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnShowLayer"/>
    
    <ImageView
        android:id="@+id/btnDelete"
        android:layout_width="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_height="match_parent"
        android:src="@drawable/ic_delete_layer"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"
        />
    <ImageView
        android:layout_width="@dimen/dp_20"
        android:adjustViewBounds="true"
        android:layout_height="match_parent"
        android:src="@drawable/ic_move_layer_item"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@id/btnDelete"
        />
        

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="#CACACA"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
